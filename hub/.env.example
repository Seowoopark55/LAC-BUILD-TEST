# LAC ONE STAGING
# Use the existing AXE HUB Supabase project's PUBLIC client credentials only.
# Never put the service-role key in a Vite frontend.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy fallback supported by the app if your project still labels it "anon".
# VITE_SUPABASE_ANON_KEY=


# Vercel server-only Discord OAuth values
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_OAUTH_STATE_SECRET=
# Optional:
# Official HUB address. Set both of these for Production after confirming the
# Discord application has the matching /api/discord/callback Redirect URI.
# DISCORD_REDIRECT_URI=https://lac-hub.vercel.app/api/discord/callback
# LAC_HUB_APP_URL=https://lac-hub.vercel.app
# Legacy AXE_PRODUCT_APP_URL is accepted for existing Vercel deployments,
# but remove it after switching to LAC_HUB_APP_URL. Never leave an old URL here.
